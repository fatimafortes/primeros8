# Copy to .env.local and fill in from the Supabase project dashboard.
# Never commit .env.local — it's gitignored already.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# No service-role key here on purpose. Seeding runs through the Supabase
# SQL Editor (superuser, bypasses RLS) and feature 7's aggregate reads
# through a SECURITY DEFINER function — the running app has no privileged
# key to leak. Add SUPABASE_SERVICE_ROLE_KEY back only if a feature
# genuinely needs it server-side, and say so when you do.
